# Copy this file to ".env" for local runs. On the host (Render/Railway/etc.) set the same names
# as environment variables. NEVER commit the real .env file.

# Supabase -> Project Settings -> API Keys
# SUPABASE_ANON_KEY takes the PUBLISHABLE key (sb_publishable_...). Older projects: the legacy anon key.
# Never put the secret key / service_role key anywhere in this project.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# https://console.anthropic.com  (server only, never put this in the HTML)
ANTHROPIC_API_KEY=sk-ant-...

# Models (change here, no code change needed)
MODEL_FAST=claude-haiku-5-5
MODEL_SMART=claude-sonnet-5-5

# Comma separated list of websites allowed to call this API
ALLOWED_ORIGINS=http://localhost:5500,https://your-site.example

# Limits per logged-in user (in-memory, per server process)
RATE_LIMIT_PER_MIN=20
DAILY_AI_LIMIT=200
MAX_TOOL_ROUNDS=5

# Used for "today", "this week" etc.
SHOP_TIMEZONE=Asia/Kolkata
